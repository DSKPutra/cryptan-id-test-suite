{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/DSKPutra/cryptan-id-test-suite/uk2_skenario/schema/uk2_skenario.schema.json",
  "title": "Cryptan.ID Test Suite — UK-2 Skenario Pengujian (masukan runner UK-3)",
  "type": "object",
  "required": ["schema", "unit", "profile", "method_review", "param_space", "scenarios", "verification", "test_cases", "traceability", "outcome_map"],
  "properties": {
    "schema": {"const": "cryptan.uk2.skenario.v1"},
    "unit": {"type": "object", "required": ["code", "module"]},
    "profile": {"type": "object", "required": ["product", "testing_model", "objects"]},
    "method_review": {"type": "object", "required": ["methods", "cells", "empty_cells"]},
    "param_space": {"type": "object", "required": ["categories"]},
    "scenarios": {"type": "array", "items": {"type": "object", "required": ["id", "tier", "layer", "recipes", "status"]}},
    "verification": {"type": "object", "required": ["status", "rules"],
                     "properties": {"status": {"enum": ["LULUS", "TEMUAN"]}}},
    "test_cases": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "tier", "layer", "targets", "parameters", "prerequisites", "steps", "pass",
                     "methods", "standards", "priority", "executor", "expected", "runner", "narrative"],
        "properties": {
          "id": {"type": "string", "pattern": "^([A-Z]{2}|[UISA])-[KSI]-\\d{2}$"},
          "tier": {"enum": ["Komponen", "Integrasi", "Sistem", "Unit", "UAT"]},
          "layer": {"enum": ["K", "S", "I"]},
          "area": {"type": ["string", "null"]},
          "targets": {"type": "array", "items": {"type": "string"}, "minItems": 1},
          "parameters": {"type": "array", "items": {"type": "object", "required": ["param", "value", "in_spec", "expect"]}},
          "steps": {"type": "array", "items": {"type": "string", "pattern": "^\\d+\\. "}, "minItems": 2},
          "expected": {"type": "array", "items": {"type": "object", "required": ["target", "file", "sha256", "status"],
                                                  "properties": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                                                                 "status": {"enum": ["COCOK_VEKTOR_RESMI", "PERLU_VERIFIKASI", "KRITERIA"]}}}},
          "runner": {"type": "object", "required": ["action", "targets", "expected_files", "inputs", "decision"],
                     "properties": {"action": {"type": "string"},
                                    "decision": {"type": "object", "required": ["kind", "outcomes"]}}},
          "priority": {"enum": ["Tinggi", "Sedang", "Rendah"]}
        }
      }
    },
    "traceability": {"type": "array", "items": {"type": "object", "required": ["requirement", "method", "scenario", "test_case", "standards"]}},
    "outcome_map": {"type": "array", "items": {"type": "object", "required": ["condition", "trigger", "outcome", "action"],
                                               "properties": {"outcome": {"enum": ["Memenuhi", "Memenuhi dengan Catatan", "Tidak Memenuhi", "Inkonklusif"]}}}}
  }
}
